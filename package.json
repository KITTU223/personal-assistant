{
  "name": "insist-clone",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "dev:worker": "cf dev",
    "deploy": "node --env-file=.env --run deploy:worker",
    "deploy:worker": "cf deploy --secrets-file worker.secrets.env"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.110",
    "@hono/node-server": "^2.1.3",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "^7.0.164",
    "hono": "^4.13.16",
    "neon": "^9.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@hono/cli": "^1.0.0-rc.9",
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^26.1.1",
    "cf": "^1.0.0-beta.28",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}